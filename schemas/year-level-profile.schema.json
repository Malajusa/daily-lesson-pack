{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-lesson-pack.local/schemas/year-level-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "coverage_semantics",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "const": "https://daily-lesson-pack.local/schemas/year-level-profile.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "coverage_semantics": {
      "const": "system-capability-not-learner-ceiling"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "path",
          "revision",
          "sha256",
          "status",
          "release_mode",
          "curriculum_anchor",
          "retrieval_guidance",
          "language_representation_guidance",
          "jurisdiction_mapping",
          "domains"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^year-[0-9]+(?:-[0-9]+)?$"
          },
          "path": {
            "type": "string",
            "pattern": "^references/year-level-profiles/[a-z0-9-]+\\.md$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "calibrated",
              "candidate",
              "scaffold"
            ]
          },
          "release_mode": {
            "enum": [
              "normal",
              "candidate"
            ]
          },
          "curriculum_anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "years",
              "source"
            ],
            "properties": {
              "years": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12
                }
              },
              "source": {
                "type": "string",
                "pattern": "^references/year-level-profiles/[a-z0-9-]+\\.md$"
              }
            }
          },
          "retrieval_guidance": {
            "type": "string",
            "pattern": "^references/year-level-profiles/[a-z0-9-]+\\.md$"
          },
          "language_representation_guidance": {
            "type": "string",
            "pattern": "^references/year-level-profiles/[a-z0-9-]+\\.md$"
          },
          "jurisdiction_mapping": {
            "type": [
              "string",
              "null"
            ]
          },
          "domains": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mathematics",
              "literacy"
            ],
            "properties": {
              "mathematics": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "source",
                  "evidence_status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "declared-baseline",
                      "candidate",
                      "scaffold"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^references/year-level-profiles/[a-z0-9-]+\\.md$"
                  },
                  "evidence_status": {
                    "const": "implemented-unverified"
                  }
                }
              },
              "literacy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "source",
                  "evidence_status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "declared-baseline",
                      "candidate",
                      "scaffold"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^references/year-level-profiles/[a-z0-9-]+\\.md$"
                  },
                  "evidence_status": {
                    "const": "implemented-unverified"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
