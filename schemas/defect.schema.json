{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-lesson-pack.local/schemas/defect.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defect_id",
    "generation_run_id",
    "review_run_id",
    "check_id",
    "severity",
    "owner",
    "scope",
    "description",
    "evidence",
    "required_correction"
  ],
  "properties": {
    "defect_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "maxLength": 160
    },
    "generation_run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "maxLength": 160
    },
    "review_run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "maxLength": 160
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "release_blocking",
        "warning"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "maxLength": 160
    },
    "scope": {
      "enum": [
        "pack",
        "instance",
        "task",
        "page"
      ]
    },
    "instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "citations"
      ],
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 12
        },
        "citations": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "https://daily-lesson-pack.local/schemas/agent-request.schema.json#/$defs/citation"
              }
            ]
          },
          "minItems": 1
        }
      }
    },
    "required_correction": {
      "type": "string",
      "minLength": 1
    }
  }
}
